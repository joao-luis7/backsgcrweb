        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"   \",\n  \"descricao\": \"Teste 400\",\n  \"precoUnidade\": -5,\n  \"precoCusto\": 6.00,\n  \"quantidadeEstoque\": -1,\n  \"categoriaId\": {{categoriaId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/produtos/update/{{produtoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "update", "{{produtoId}}"]
        }
      }
    },
    {
      "name": "8c. Atualizar Produto Inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 404 Not Found', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test('ErrorResponse com status 404', function () {",
              "    pm.expect(pm.response.json().status).to.eql(404);",
              "});"
            ]
          }
