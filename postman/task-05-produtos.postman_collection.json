        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Produto Inexistente\",\n  \"descricao\": \"Teste 404\",\n  \"precoUnidade\": 10.00,\n  \"precoCusto\": 5.00,\n  \"quantidadeEstoque\": 10,\n  \"categoriaId\": {{categoriaId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
