        "url": {
          "raw": "{{baseUrl}}/produtos/update/999999",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "update", "999999"]
        }
      }
    },
    {
      "name": "9a. Inativar Produto Existente (204)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 204 No Content', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/delete/{{produtoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "delete", "{{produtoId}}"]
        }
      }
    },
    {
      "name": "9b. Confirmar Inativação Lógica Pós-DELETE (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Produto preservado com ativo === false (DOM-05)', function () {",
              "    pm.expect(pm.response.json().ativo).to.eql(false);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/findbyid/{{produtoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "findbyid", "{{produtoId}}"]
