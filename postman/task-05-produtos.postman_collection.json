{
  "info": {
    "name": "SGCR - Task 05 - Produtos",
    "description": "Roteiro de testes REST do módulo Produto (/produtos).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "produtoId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "categoriaId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Setup — Criar Categoria para Produto (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Retorna categoria criada com id', function () {",
              "    pm.expect(json.id).to.be.a('number');",
              "    pm.expect(json.nome).to.eql('Bebidas Teste Produto');",
              "});",
              "pm.collectionVariables.set('categoriaId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Bebidas Teste Produto\",\n  \"descricao\": \"Categoria temporária para validação de produtos\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/categorias/save",
          "host": ["{{baseUrl}}"],
          "path": ["categorias", "save"]
        }
      }
    },
    {
      "name": "1. Cadastrar Produto (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Retorna ProdutoResponseDTO com id, categoriaId, categoriaNome e ativo=true', function () {",
              "    pm.expect(json.id).to.be.a('number');",
              "    pm.expect(json.categoriaId).to.eql(Number(pm.collectionVariables.get('categoriaId')));",
              "    pm.expect(json.categoriaNome).to.eql('Bebidas Teste Produto');",
              "    pm.expect(json.ativo).to.eql(true);",
              "});",
              "pm.collectionVariables.set('produtoId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Refrigerante Cola 2L\",\n  \"descricao\": \"Garrafa PET 2 Litros\",\n  \"precoUnidade\": 10.50,\n  \"precoCusto\": 6.00,\n  \"quantidadeEstoque\": 20,\n  \"categoriaId\": {{categoriaId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/produtos/save",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "save"]
        }
      }
    },
    {
      "name": "2. Validação de Preço/Estoque Inválidos no POST (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Produto Inválido\",\n  \"descricao\": \"Teste 400\",\n  \"precoUnidade\": 0,\n  \"precoCusto\": 6.00,\n  \"quantidadeEstoque\": -1,\n  \"categoriaId\": {{categoriaId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/produtos/save",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "save"]
        }
      }
    },
    {
      "name": "3. Listar Todos os Produtos (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna array não vazio de produtos', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/findall",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "findall"]
        }
      }
    },
    {
      "name": "4. Listar Produtos Ativos (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Todos os produtos retornados estão ativos', function () {",
              "    const list = pm.response.json();",
              "    pm.expect(list).to.be.an('array');",
              "    list.forEach(p => pm.expect(p.ativo).to.eql(true));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/ativos",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "ativos"]
        }
      }
    },
    {
      "name": "5. Listar Produtos Ativos com Categoria (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const list = pm.response.json();",
              "const expectedId = Number(pm.collectionVariables.get('produtoId'));",
              "pm.test('Contém o produto criado com categoriaNome preenchido', function () {",
              "    pm.expect(list).to.be.an('array');",
              "    const item = list.find(p => p.id === expectedId);",
              "    pm.expect(item).to.be.an('object');",
              "    pm.expect(item.categoriaNome).to.eql('Bebidas Teste Produto');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/ativos-com-categoria",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "ativos-com-categoria"]
        }
      }
    },
    {
      "name": "6a. Buscar Produto por ID Existente (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna produto esperado', function () {",
              "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get('produtoId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/findbyid/{{produtoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "findbyid", "{{produtoId}}"]
        }
      }
    },
    {
      "name": "6b. Buscar Produto por ID Inexistente (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 404 Not Found', function () {",
              "    pm.response.to.have.status(404);",
              "});",
              "pm.test('ErrorResponse com status 404', function () {",
              "    pm.expect(pm.response.json().status).to.eql(404);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/findbyid/999999",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "findbyid", "999999"]
        }
      }
    },
    {
      "name": "7. Buscar Produto por Nome (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna array não vazio', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/produtos/findbynome?nome=cola",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "findbynome"],
          "query": [
            {
              "key": "nome",
              "value": "cola"
            }
          ]
        }
      }
    },
    {
      "name": "8a. Atualizar Produto Existente (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Atualiza preço e estoque do produto', function () {",
              "    pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('produtoId')));",
              "    pm.expect(json.precoUnidade).to.eql(11);",
              "    pm.expect(json.quantidadeEstoque).to.eql(15);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Refrigerante Cola 2L Atualizado\",\n  \"descricao\": \"Garrafa PET 2 Litros\",\n  \"precoUnidade\": 11.00,\n  \"precoCusto\": 6.00,\n  \"quantidadeEstoque\": 15,\n  \"categoriaId\": {{categoriaId}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/produtos/update/{{produtoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "update", "{{produtoId}}"]
        }
      }
    },
