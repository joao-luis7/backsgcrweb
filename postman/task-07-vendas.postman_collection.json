    {
      "name": "6a. Buscar Venda Detalhada por ID Existente (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Retorna venda detalhada com itens', function () {",
              "    pm.expect(json.id).to.eql(Number(pm.collectionVariables.get('vendaId')));",
              "    pm.expect(json.itens).to.be.an('array').with.lengthOf(1);",
              "    pm.expect(json.statusVenda).to.eql('FINALIZADA');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/vendas/findbyid/{{vendaId}}",
          "host": ["{{baseUrl}}"],
          "path": ["vendas", "findbyid", "{{vendaId}}"]
        }
      }
    },
