{
  "info": {
    "name": "SGCR - Task 07 - Vendas",
    "description": "Roteiro de testes REST do módulo Venda (/vendas).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "clienteVendaId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "produtoVendaId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "vendaId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0a. Setup — Criar Cliente para Venda (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Cliente criado com id', function () {",
              "    pm.expect(json.id).to.be.a('number');",
              "});",
              "pm.collectionVariables.set('clienteVendaId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Cliente Teste Venda\",\n  \"telefone\": \"77999112233\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/clientes/save",
          "host": ["{{baseUrl}}"],
          "path": ["clientes", "save"]
        }
      }
    },
    {
      "name": "0b. Setup — Criar Produto com Estoque para Venda (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Produto criado com id e estoque', function () {",
              "    pm.expect(json.id).to.be.a('number');",
              "    pm.expect(json.quantidadeEstoque).to.eql(20);",
              "});",
              "pm.collectionVariables.set('produtoVendaId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Produto Teste Venda\",\n  \"descricao\": \"Item de teste\",\n  \"precoUnidade\": 25.00,\n  \"precoCusto\": 12.00,\n  \"quantidadeEstoque\": 20\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/produtos/save",
          "host": ["{{baseUrl}}"],
          "path": ["produtos", "save"]
        }
      }
    },
    {
      "name": "1. Venda à Vista Sem Cliente (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Venda à vista calculada no servidor (SEC-03)', function () {",
              "    pm.expect(json.clienteNome).to.eql('Não Identificado');",
              "    pm.expect(json.valorTotal).to.eql(50);",
              "    pm.expect(json.statusVenda).to.eql('FINALIZADA');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": null,\n  \"formaPagamento\": \"PIX\",\n  \"itens\": [\n    {\n      \"produtoId\": {{produtoVendaId}},\n      \"quantidade\": 2\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/vendas/save",
          "host": ["{{baseUrl}}"],
          "path": ["vendas", "save"]
        }
      }
    },
    {
      "name": "2. Venda FIADO com Cliente Identificado (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Venda FIADO registrada corretamente', function () {",
              "    pm.expect(json.clienteId).to.eql(Number(pm.collectionVariables.get('clienteVendaId')));",
              "    pm.expect(json.formaPagamento).to.eql('FIADO');",
              "    pm.expect(json.valorTotal).to.eql(75);",
              "});",
              "pm.collectionVariables.set('vendaId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": {{clienteVendaId}},\n  \"formaPagamento\": \"FIADO\",\n  \"itens\": [\n    {\n      \"produtoId\": {{produtoVendaId}},\n      \"quantidade\": 3\n    }\n  ]\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/vendas/save",
          "host": ["{{baseUrl}}"],
          "path": ["vendas", "save"]
        }
      }
    },
