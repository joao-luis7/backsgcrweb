{
  "info": {
    "name": "SGCR - Task 08 - Pagamentos",
    "description": "Roteiro de testes REST do módulo Pagamento (/pagamentos).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "pagamentoId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "clienteId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Registrar Pagamento (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Retorna PagamentoResponseDTO com clienteSaldoDevedorAtual', function () {",
              "    pm.expect(json.id).to.be.a('number');",
              "    pm.expect(json.clienteId).to.eql(1);",
              "    pm.expect(json.clienteSaldoDevedorAtual).to.be.a('number');",
              "});",
              "pm.collectionVariables.set('pagamentoId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": 1,\n  \"valorTotal\": 5.00,\n  \"formaPagamento\": \"PIX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pagamentos/save",
          "host": ["{{baseUrl}}"],
          "path": ["pagamentos", "save"]
        }
      }
    },
    {
      "name": "2. Erro ao Pagar Maior que Saldo Devedor (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": 1,\n  \"valorTotal\": 999999.00,\n  \"formaPagamento\": \"PIX\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pagamentos/save",
          "host": ["{{baseUrl}}"],
          "path": ["pagamentos", "save"]
        }
      }
    },
    {
      "name": "3. Listar Todos os Pagamentos (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna array de pagamentos', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pagamentos/findall",
          "host": ["{{baseUrl}}"],
          "path": ["pagamentos", "findall"]
        }
      }
    },
    {
      "name": "4. Buscar Pagamento por ID (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK ou 404 Not Found', function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pagamentos/findbyid/{{pagamentoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["pagamentos", "findbyid", "{{pagamentoId}}"]
        }
      }
    },
    {
      "name": "5. Listar Pagamentos por Cliente (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Retorna array de pagamentos do cliente', function () {",
              "    pm.expect(pm.response.json()).to.be.an('array');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pagamentos/cliente/{{clienteId}}",
          "host": ["{{baseUrl}}"],
          "path": ["pagamentos", "cliente", "{{clienteId}}"]
        }
      }
    },
    {
      "name": "6. Faturamento dos Últimos 30 Dias (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Contém faturamentoUltimos30Dias', function () {",
              "    pm.expect(pm.response.json()).to.have.property('faturamentoUltimos30Dias');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pagamentos/faturamento-30-dias",
          "host": ["{{baseUrl}}"],
          "path": ["pagamentos", "faturamento-30-dias"]
        }
      }
    },
    {
      "name": "7. Atualizar Recibo (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 200 OK ou 404 Not Found', function () {",
              "    pm.expect([200, 404]).to.include(pm.response.code);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clienteId\": 1,\n  \"valorTotal\": 6.00,\n  \"formaPagamento\": \"DINHEIRO\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/pagamentos/update/{{pagamentoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["pagamentos", "update", "{{pagamentoId}}"]
        }
      }
    },
    {
      "name": "8. Excluir/Estornar Pagamento (204)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 204 No Content', function () {",
              "    pm.response.to.have.status(204);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/pagamentos/delete/{{pagamentoId}}",
          "host": ["{{baseUrl}}"],
          "path": ["pagamentos", "delete", "{{pagamentoId}}"]
        }
      }
    }
  ]
}
