      "name": "0a. Setup — Criar Cliente para Pagamento (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status é 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const json = pm.response.json();",
              "pm.test('Cliente criado com id', function () {",
              "    pm.expect(json.id).to.be.a('number');",
              "});",
              "pm.collectionVariables.set('clientePagId', json.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
